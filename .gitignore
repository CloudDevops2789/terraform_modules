# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Keep the provider lock file
!.terraform.lock.hcl
backend.hcl
*.backend.hcl

# Generated test output and Terraform plan artifacts
**/test-logs/
*.tfplan
tfplan
tfplan.*

# Version-controlled Sandbox network security policy
!terraform/environments/sandbox/network-policy.auto.tfvars
