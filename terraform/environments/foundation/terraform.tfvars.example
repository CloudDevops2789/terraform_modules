aws_region  = "us-east-1"
name_prefix = "org-ire-sandbox-use1"

tags = {
  "fv:it_cost_center"       = "replace-with-approved-cost-center"
  "fv:department"           = "replace-with-approved-department"
  "fv:cmdb_calculated_app"  = "replace-with-approved-application"
  "fv:business_criticality" = "replace-with-approved-criticality"
  "fv:environment"          = "replace-with-approved-environment"
  "fv:data_classification"  = "replace-with-approved-classification"
  "fv:project_name"         = "AWS-IRE"
  "fv:managed_by"           = "Terraform"
}

# Approved retention boundaries for the logically air-gapped vault.
air_gapped_min_retention_days = 30
air_gapped_max_retention_days = 365

# Stable IAM principal ARN only.
# Do not use arn:aws:sts::* assumed-role session ARNs.
kms_key_administrators = [
  "arn:aws:iam::123456789012:role/replace-with-approved-terraform-role"
]

network_firewall_log_group_prefix = "/aws/network-firewall/org-ire-sandbox-use1-centralized-inspection"
