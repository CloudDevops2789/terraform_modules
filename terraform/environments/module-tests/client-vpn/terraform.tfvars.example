# Copy to terraform.tfvars and adjust if needed.
# aws_region defaults to "us-east-1"; override only if this module needs to
# be validated against a different Region.
# aws_region = "us-east-1"

# Home Lab (default): leave server_certificate_arn and
# root_certificate_chain_arn commented out below. This test then generates
# a throwaway self-signed CA and server certificate itself, so
# `terraform apply` is fully self-contained.

# Enterprise: uncomment both and point them at real ACM certificates you
# already manage, exactly as terraform/environments/sandbox does. Both must
# be set together - setting only one still triggers throwaway generation.
# server_certificate_arn     = "arn:aws:acm:us-east-1:123456789012:certificate/CHANGE_ME"
# root_certificate_chain_arn = "arn:aws:acm:us-east-1:123456789012:certificate/CHANGE_ME"
