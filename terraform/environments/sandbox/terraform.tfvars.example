################################################################################
# Sandbox Runtime and External Binding Example
################################################################################
#
# Git-controlled architecture:
#
#   platform.auto.tfvars
#   network-policy.auto.tfvars
#
# AAP supplies only runtime intent and approved environment-specific external
# bindings.
#
# Never commit credentials, private keys, passwords, or SAML metadata.
################################################################################

################################################################################
# Deployment Region
################################################################################

# Local Terraform runtime binding.
# AAP derives this automatically from assume_role_aws_region.
aws_region = "us-east-1"

# Enterprise example:
# aws_region = "us-east-2"

################################################################################
# Temporary validation workloads
################################################################################

demo_ec2_enabled = false

# Required only when demo_ec2_enabled = true.
# The AMI must exist in aws_region.
# ami_id = "ami-0123456789abcdef0"

################################################################################
# Client VPN external prerequisites
################################################################################
#
# Initial platform bootstrap keeps client_vpn_enabled=false in
# platform.auto.tfvars, therefore these are not initially required.
#
# After PKI and Identity prerequisites are ready, change
# client_vpn_enabled=true through Git review and supply the appropriate
# external references through AAP.
################################################################################

# Required whenever Client VPN is enabled.
# server_certificate_arn = "arn:aws:acm:<region>:<account>:certificate/<id>"

# Required for the enterprise federated/SAML target.
# saml_provider_arn = "arn:aws:iam::<account>:saml-provider/<name>"

# Required only if Git deliberately selects certificate authentication.
# root_certificate_chain_arn = "arn:aws:acm:<region>:<account>:certificate/<id>"

################################################################################
# Optional external bindings
################################################################################

# Required only when Git selects external SSM instance-profile ownership.
# ssm_instance_profile_name = "approved-existing-profile"

# Supply only when an enabled Foundation integration requires external
# Foundation references.
#
# foundation_resources = {
#   standard_backup_vault_name           = "approved-standard-vault"
#   air_gapped_backup_vault_arn          = "arn:aws:backup:<region>:<account>:backup-vault:<name>"
#   network_firewall_logging_kms_key_arn = "arn:aws:kms:<region>:<account>:key/<id>"
# }
